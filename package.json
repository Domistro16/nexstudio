{
  "name": "studio-v1-standalone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "engines:install": "python scripts/install-engines.py",
    "worker": "tsx scripts/studio-worker.ts --watch",
    "worker:once": "tsx scripts/studio-worker.ts",
    "qa": "python scripts/standalone-qa.py",
    "worker:uploads": "tsx scripts/studio-upload-scan-worker.ts",
    "worker:account-data": "tsx scripts/studio-account-data-worker.ts",
    "qa:trust": "python scripts/trust-commerce-security-qa.py",
    "test:billing-adversarial": "python tests/trust-commerce/adversarial_billing_model_test.py",
    "test:trust-runtime": "node tests/trust-commerce/runtime_security_unit_test.cjs",
    "test:trust-real-db": "tsx tests/trust-commerce/real_db_adversarial_test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "dotenv": "17.4.2",
    "next": "16.2.10",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "4.23.1",
    "zod": "4.4.3",
    "@hyperframes/core": "0.7.56",
    "@hyperframes/lint": "0.7.56",
    "@hyperframes/player": "0.7.56",
    "fflate": "0.8.2",
    "gsap": "3.14.2",
    "playwright-core": "1.61.1",
    "sharp": "^0.34.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "motion": "12.43.0",
    "ogl": "1.0.11"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "prisma": "7.8.0",
    "typescript": "5.9.3"
  },
  "studioCreativeAuthority": "NEXMIND_P8_CANONICAL_CREATIVE_AUTHORITY",
  "legacyDirectorPolicy": "DELETED_FROM_CANONICAL_SOURCE"
}
